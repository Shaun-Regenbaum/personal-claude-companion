# Claude Companion - Local Configuration
# Copy to .env.local and customize (gitignored automatically by Vite)

# Enable broken symlink detection for skills
VITE_SKILL_HEALTH_CHECK=true

# Team skills repo (for detecting broken symlinks)
VITE_TEAM_SKILLS_REPO_PATH=/path/to/shared-skills
VITE_TEAM_SKILLS_REPO_URL=https://github.com/your-org/shared-skills

# Server port (default 3848)
COMPANION_PORT=3848

# AI title generation — Cloudflare Worker URL
# Deploy the worker from worker/ dir: cd worker && npx wrangler deploy
# TITLE_WORKER_URL=https://companion-titles.<your-subdomain>.workers.dev
