{
  "name": "personal-claude-companion",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:client",
    "dev:client": "vite",
    "dev:server": "NODE_ENV=development bun --watch server/index.ts",
    "build": "tsc -b && vite build",
    "compile": "bun run build && bun build --compile --minify --bytecode --sourcemap --compile-exec-argv='--smol' ./server/index.ts --outfile companion",
    "start": "bun server/index.ts",
    "start:prod": "./companion",
    "stop": "pkill -f 'bun server/index.ts' || pkill -x companion || true",
    "status": "(pgrep -x companion || pgrep -f 'bun server/index.ts') > /dev/null 2>&1 && echo 'running' || echo 'stopped'",
    "logs": "tail -f ~/.claude/companion-logs/stdout.log",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "hono": "^4.12.9",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.11",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.77.0"
  }
}
